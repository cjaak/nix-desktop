[
  // ── Top bar – all monitors ─────────────────────────────────────────────────
  // Left: CPU usage / RAM / temp   Center: clock   Right: GPU temp / mem / usage
  {
    "layer": "top",
    "position": "top",
    "height": 32,
    "modules-left":   ["cpu", "memory", "temperature"],
    "modules-center": ["clock"],
    "modules-right":  ["custom/gpu-temp", "custom/gpu-mem", "custom/gpu-usage"],

    "cpu": {
      "interval": 1,
      "format": "󰘚  {usage}%",
      "on-click": "wezterm -e btop"
    },
    "memory": {
      "interval": 1,
      "format": "  {used:0.1f}G"
    },
    "temperature": {
      "hwmon-path": "/sys/devices/pci0000:00/0000:00:18.3/hwmon/hwmon1/temp1_input",
      "critical-threshold": 90,
      "interval": 1,
      "format": "  {temperatureC}°C",
      "format-critical": "  {temperatureC}°C"
    },
    "clock": {
      "interval": 30,
      "format": "  {:%H:%M}    {:%d %b %Y}",
      "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "custom/gpu-temp": {
      "exec": "nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader | awk '{print $1\"°C\"}'",
      "interval": 1,
      "format": "  {}"
    },
    "custom/gpu-mem": {
      "exec": "nvidia-smi --query-gpu=memory.used --format=csv,noheader",
      "interval": 1,
      "format": "  {}"
    },
    "custom/gpu-usage": {
      "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits | awk '{print $1\"%\"}'",
      "interval": 1,
      "format": "  {}"
    }
  },

  // ── Bottom bar – DP-2 (LG UltraGear, primary) ──────────────────────────────
  // Left: UFW / network   Center: workspaces   Right: tray / audio
  {
    "layer": "top",
    "output": "DP-2",
    "position": "bottom",
    "height": 32,
    "modules-left":   ["custom/ufw", "network"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right":  ["tray", "pulseaudio"],

    "custom/ufw": {
      "exec": "systemctl is-active --quiet ufw && printf '{\"text\":\"󱨑\",\"class\":\"active\",\"tooltip\":\"UFW active\"}' || printf '{\"text\":\"󱨑\",\"class\":\"inactive\",\"tooltip\":\"UFW inactive\"}'",
      "return-type": "json",
      "interval": 60,
      "format": "{}"
    },
    "network": {
      "interface": "enp10s0",
      "interval": 1,
      "format-ethernet": "󰈀  ↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
      "format-disconnected": "󰈂  disconnected",
      "tooltip-format-ethernet": "{ipaddr}"
    },
    "hyprland/workspaces": {
      "all-outputs": true,
      "format": "{id}",
      "on-click": "activate"
    },
    "tray": {
      "spacing": 6
    },
    "pulseaudio": {
      "format": "󰕾  {volume}%",
      "format-muted": "󰝟  {volume}%",
      "on-click": "pavucontrol",
      "scroll-step": 5
    }
  },

  // ── Bottom bar – DP-3 (LG UltraWide) ──────────────────────────────────────
  {
    "layer": "top",
    "output": "DP-3",
    "position": "bottom",
    "height": 32,
    "modules-center": ["hyprland/workspaces"],
    "modules-right":  ["clock"],

    "hyprland/workspaces": {
      "all-outputs": true,
      "format": "{id}",
      "on-click": "activate"
    },
    "clock": {
      "interval": 30,
      "format": "  {:%H:%M}    {:%d %b}"
    }
  },

  // ── Bottom bar – HDMI-A-2 (Huawei, portrait) ───────────────────────────────
  {
    "layer": "top",
    "output": "HDMI-A-2",
    "position": "bottom",
    "height": 32,
    "modules-center": ["hyprland/workspaces"],
    "modules-right":  ["clock"],

    "hyprland/workspaces": {
      "all-outputs": true,
      "format": "{id}",
      "on-click": "activate"
    },
    "clock": {
      "interval": 30,
      "format": "  {:%H:%M}    {:%d %b}"
    }
  }
]